# Optional overrides for docker-compose.yml. Copy to .env and adjust (never commit .env).
# Without a .env, `docker compose up --build` serves the app on https://localhost:2025 and on
# https://<this machine's LAN IP>:2025 for phones and other devices (self-signed certificate).

# --- First admin (created once, on a fresh database; never changed afterwards) ----------
# Without these the first admin is admin@gmail.com / admin. The app shows a reminder until the password
# is changed. Set ADMIN_PASSWORD to an empty value to generate a random one (printed in `docker compose logs api`).
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=admin

# --- Core ------------------------------------------------------------------------------
# Leave empty to auto-generate a strong key (persisted in the private_media volume).
# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Public domain names you serve the app on. LAN access needs no entries: with ALLOW_PRIVATE_NETWORK_HOSTS=true
# any private address (http://192.168.x.x:2025, http://10.x.x.x:2025, http://my-pc.local:2025 …) works
# automatically, whatever IP the machine gets. Set it to false on a server that must only answer its domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ALLOW_PRIVATE_NETWORK_HOSTS=true
# Only needed for HTTPS origins behind another proxy; same-origin requests (incl. LAN IPs) work without it.
CSRF_TRUSTED_ORIGINS=
# Only needed if the SPA is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=
# Base URL for QR codes, PDFs and email links. Leave empty to use the address people open the app on.
FRONTEND_URL=
ORG_NAME=Asset Management Tools
# Currency for new assets, totals and PDFs (ISO code), and how amounts are formatted.
# en-IN groups as ₹1,00,000 and abbreviates to lakh/crore; use e.g. en-US with USD.
DEFAULT_CURRENCY=INR
CURRENCY_LOCALE=en-IN
VITE_APP_NAME=Asset Management Tools
TIME_ZONE=UTC
DJANGO_ADMIN_URL=admin/

# --- TLS / cookies -------------------------------------------------------------------------
# auto: HTTPS on :2025 using nginx/certs/{fullchain,privkey}.pem if present, otherwise a self-signed
# certificate generated once (browsers warn once per device; phone cameras need HTTPS). off: plain HTTP.
HTTPS=auto
# Optional extra names/IPs for the self-signed certificate, e.g. assets.lan,192.168.1.10
TLS_HOSTS=
# These follow HTTPS automatically (on with HTTPS, off with HTTPS=off). Uncomment only to override.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_COOKIES=true
# JWT_COOKIE_SECURE=true
DJANGO_HSTS_SECONDS=31536000

# --- Database ----------------------------------------------------------------------------
POSTGRES_DB=asset
POSTGRES_USER=asset
# Change for anything beyond a local trial (Postgres is only reachable inside the Docker network).
POSTGRES_PASSWORD=asset_local_only
# Database connection pool per process (keeps the total under Postgres' max_connections=40).
DB_POOL=true
DB_POOL_MAX=6

# --- Auth --------------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN=10/min

# --- Email (SMTP) — secrets live only here, never in the database or API -----------------
# Leave SMTP_HOST empty to print emails to the logs instead (or use the MailHog dev override).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=assets@example.com

# --- SMS ---------------------------------------------------------------------------------
# console (logs only) | twilio | msg91. The provider can also be switched in Reminders → Channels.
SMS_PROVIDER=console
# Twilio: "ACCOUNT_SID:AUTH_TOKEN"   MSG91: your auth key
SMS_API_KEY=
SMS_SENDER_ID=

# --- Uploads ------------------------------------------------------------------------------
# Media columns (photo / file per cell); nginx accepts request bodies up to 20 MB.
MAX_MEDIA_UPLOAD_MB=15
MAX_IMPORT_ROWS=5000

# --- Backups -----------------------------------------------------------------------------
# Daily database backup time (in TIME_ZONE) and how many daily backups to keep. Manual backups
# (Settings -> Backups) are kept until deleted.
BACKUP_TIME=02:00
BACKUP_KEEP=7
# Largest backup file that can be uploaded in Settings -> Backups (nginx allows up to 1 GB there).
BACKUP_UPLOAD_MAX_MB=1024

# --- Reminders ---------------------------------------------------------------------------
REMINDER_ATTACHMENT_MAX_MB=10
REMINDER_LINK_HOURS=72

# --- Runtime (tuned for a small server) -----------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# gunicorn (default, multi-process) or daphne (single process, smallest RAM)
ASGI_SERVER=gunicorn
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=1
WARRANTY_ALERT_DAYS=30,7,0
MAINTENANCE_ALERT_DAYS=7

# --- Published ports ---------------------------------------------------------------------
FRONTEND_PORT=2025
BACKEND_PORT=2000
# Keep the API on localhost so traffic goes through nginx (headers, rate limits, /admin/ allowlist).
BACKEND_BIND=127.0.0.1
APP_VERSION=latest
