# Copy to nginx/conf.d/default.conf (replacing it) and mount certs at nginx/certs/{fullchain.pem,privkey.pem}.
# The app is then served over HTTPS on port 2025 (put a 443 -> 2025 mapping or load balancer in front for a bare domain).
map $http_x_forwarded_proto $forwarded_proto { default $scheme; }

server {
  listen 2025 ssl default_server;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Plain HTTP sent to the TLS port gets a redirect instead of a 400.
  error_page 497 =301 https://$host:$server_port$request_uri;

  include /etc/nginx/snippets/app.conf;
}
